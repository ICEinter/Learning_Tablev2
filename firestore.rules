rules_version = '2';
// Firestore Security Rules â€” à¸£à¸°à¸šà¸šà¸ˆà¸±à¸”à¸•à¸²à¸£à¸²à¸‡à¸à¸²à¸£à¹€à¸£à¸µà¸¢à¸™à¸à¸²à¸£à¸ªà¸­à¸™
// à¸«à¸¥à¸±à¸à¸à¸²à¸£: deny-by-default, à¸—à¸¸à¸ path à¸œà¸¹à¸ schoolId à¸à¸±à¸š custom claims,
// à¸•à¸²à¸£à¸²à¸‡/views/jobs/imports/audit/users à¹€à¸‚à¸µà¸¢à¸™à¹„à¸”à¹‰à¹€à¸‰à¸žà¸²à¸° server (Admin SDK à¸‚à¹‰à¸²à¸¡ rules)
// à¸—à¸”à¸ªà¸­à¸š: tests/rules/firestore.rules.test.ts (à¸£à¸±à¸™à¸”à¹‰à¸§à¸¢ Emulator à¹ƒà¸™ CI)
service cloud.firestore {
  match /databases/{database}/documents {

    function authed()      { return request.auth != null; }
    function claim(k)      { return request.auth.token.get(k, null); }
    function inSchool(s)   { return authed() && claim('schoolId') == s; }
    function isMember(s)   { return inSchool(s) && claim('role') in ['admin', 'teacher', 'student']; }
    function isAdmin(s)    { return inSchool(s) && claim('role') == 'admin'; }
    function isTeacher(s)  { return inSchool(s) && claim('role') == 'teacher'; }
    function isStudent(s)  { return inSchool(s) && claim('role') == 'student'; }
    function myGroup(g)    { return g in request.auth.token.get('groupIds', []); }
    function versionStatus(s, t, v) {
      return get(/databases/$(database)/documents/schools/$(s)/terms/$(t)/timetables/$(v)).data.status;
    }

    // à¹‚à¸›à¸£à¹„à¸Ÿà¸¥à¹Œà¸œà¸¹à¹‰à¹ƒà¸Šà¹‰ â€” à¹€à¸‚à¸µà¸¢à¸™à¹‚à¸”à¸¢ server à¹€à¸—à¹ˆà¸²à¸™à¸±à¹‰à¸™
    match /users/{uid} {
      allow read: if authed() && (request.auth.uid == uid || isAdmin(resource.data.schoolId));
      allow write: if false;
    }

    match /schools/{s} {
      // คอลเลกชันจัดเก็บประวัติไฟล์ Firebase Storage
      match /storage_files/{fileId} {
        allow read: if isMember(s) || isAdmin(s);
        allow write: if isAdmin(s);
      }
      allow read: if isMember(s);
      // admin à¹à¸à¹‰à¸‚à¹‰à¸­à¸¡à¸¹à¸¥à¸ªà¸–à¸²à¸™à¸¨à¸¶à¸à¸©à¸²à¹„à¸”à¹‰à¹€à¸‰à¸žà¸²à¸°à¸Ÿà¸´à¸¥à¸”à¹Œà¸—à¸µà¹ˆà¸à¸³à¸«à¸™à¸”; à¸¥à¸šà¹„à¸¡à¹ˆà¹„à¸”à¹‰
      allow create, update: if isAdmin(s)
        && request.resource.data.keys().hasOnly(['name', 'regularEndTime', 'signatories', 'timezone', 'activeTermId']);
      allow delete: if false;

      // à¸™à¸±à¸à¹€à¸£à¸µà¸¢à¸™ (PII à¸‚à¸±à¹‰à¸™à¸•à¹ˆà¸³) â€” admin à¸«à¸£à¸·à¸­à¹€à¸ˆà¹‰à¸²à¸‚à¸­à¸‡à¸‚à¹‰à¸­à¸¡à¸¹à¸¥à¹€à¸—à¹ˆà¸²à¸™à¸±à¹‰à¸™
      match /students/{id} {
        allow read: if isAdmin(s) || (isStudent(s) && claim('studentId') == id);
        allow write: if isAdmin(s);
      }
      match /academicYears/{id} {
        allow read: if isMember(s);
        allow write: if isAdmin(s);
      }
      match /importBatches/{id} {
        allow read: if isAdmin(s);
        allow write: if false;
      }
      match /auditLog/{id} {
        allow read: if isAdmin(s);
        allow write: if false;
      }

      match /terms/{t} {
        allow read: if isMember(s);
        // publishedVersionId à¸•à¸±à¹‰à¸‡à¹„à¸”à¹‰à¹€à¸‰à¸žà¸²à¸° server à¸•à¸­à¸™à¹€à¸œà¸¢à¹à¸žà¸£à¹ˆ
        allow create: if isAdmin(s)
          && request.resource.data.keys().hasOnly(['year', 'term', 'status', 'name', 'yearId', 'startDate', 'endDate']);
        allow update: if isAdmin(s)
          && request.resource.data.keys().hasOnly(['year', 'term', 'status', 'name', 'yearId', 'startDate', 'endDate', 'publishedVersionId'])
          && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['publishedVersionId']);
        allow delete: if false;

        match /config/{d} {
          allow read: if isMember(s);
          allow write: if isAdmin(s);
        }
        // à¸‚à¹‰à¸­à¸¡à¸¹à¸¥à¸«à¸¥à¸±à¸à¸—à¸µà¹ˆà¹ƒà¸Šà¹‰à¹à¸ªà¸”à¸‡à¸•à¸²à¸£à¸²à¸‡: à¸ªà¸¡à¸²à¸Šà¸´à¸à¸‚à¸­à¸‡à¸ªà¸–à¸²à¸™à¸¨à¸¶à¸à¸©à¸²à¸­à¹ˆà¸²à¸™à¹„à¸”à¹‰, admin à¹€à¸‚à¸µà¸¢à¸™
        match /courses/{id} {
          allow read: if isMember(s);
          allow write: if isAdmin(s);
        }
        match /teachers/{id} {
          allow read: if isMember(s);
          allow write: if isAdmin(s);
        }
        match /rooms/{id} {
          allow read: if isMember(s);
          allow write: if isAdmin(s);
        }
        match /groups/{id} {
          allow read: if isMember(s);
          allow write: if isAdmin(s);
        }
        match /activities/{id} {
          allow read: if isMember(s);
          allow write: if isAdmin(s);
        }
        // assignments à¸ˆà¸³à¹€à¸›à¹‡à¸™à¸•à¹ˆà¸­à¸à¸²à¸£à¸–à¸­à¸”à¸£à¸«à¸±à¸ªà¸•à¸²à¸£à¸²à¸‡à¸—à¸µà¹ˆà¹€à¸œà¸¢à¹à¸žà¸£à¹ˆ (à¹„à¸¡à¹ˆà¸¡à¸µ PII)
        match /assignments/{id} {
          allow read: if isMember(s);
          allow write: if isAdmin(s);
        }
        match /enrollments/{id} {
          allow read: if isAdmin(s) || (isStudent(s) && claim('studentId') == id);
          allow write: if isAdmin(s);
        }

        // à¸•à¸²à¸£à¸²à¸‡: admin à¸­à¹ˆà¸²à¸™à¸—à¸¸à¸à¸ªà¸–à¸²à¸™à¸°; à¸ªà¸¡à¸²à¸Šà¸´à¸à¸­à¸·à¹ˆà¸™à¸­à¹ˆà¸²à¸™à¹„à¸”à¹‰à¹€à¸‰à¸žà¸²à¸°à¸‰à¸šà¸±à¸šà¸—à¸µà¹ˆà¹€à¸œà¸¢à¹à¸žà¸£à¹ˆ (à¸‰à¸šà¸±à¸šà¸£à¹ˆà¸²à¸‡à¸¡à¸­à¸‡à¹„à¸¡à¹ˆà¹€à¸«à¹‡à¸™)
        match /timetables/{v} {
          allow read: if isAdmin(s) || (isMember(s) && resource.data.status == 'published');
          allow write: if false;

          // views à¸­à¹ˆà¸²à¸™à¹„à¸”à¹‰à¹€à¸¡à¸·à¹ˆà¸­à¹€à¸§à¸­à¸£à¹Œà¸Šà¸±à¸™à¹à¸¡à¹ˆà¹€à¸œà¸¢à¹à¸žà¸£à¹ˆà¹à¸¥à¹‰à¸§à¹€à¸—à¹ˆà¸²à¸™à¸±à¹‰à¸™ (à¹€à¸‚à¸µà¸¢à¸™à¸à¹ˆà¸­à¸™à¹€à¸›à¸¥à¸µà¹ˆà¸¢à¸™à¸ªà¸–à¸²à¸™à¸°à¹„à¸”à¹‰à¹‚à¸”à¸¢à¹„à¸¡à¹ˆà¸£à¸±à¹ˆà¸§)
          match /views/{viewId} {
            allow read: if isAdmin(s)
              || (isMember(s) && versionStatus(s, t, v) == 'published' && (
                   (isTeacher(s) && viewId == 't_' + claim('teacherId'))
                || (isStudent(s) && viewId.matches('^g_.+') && myGroup(viewId.replace('^g_', '')))
              ));
            allow write: if false;
          }
        }

        match /solverJobs/{j} {
          allow read: if isAdmin(s);
          allow write: if false;
          match /logs/{c} {
            allow read: if isAdmin(s);
            allow write: if false;
          }
        }
      }
    }
  }
}
